{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "bun run typecheck && bun run fmt && bun run lint",
    "dev": "BUN_PORT=3001 bun --hot ./app/index.server.ts",
    "fmt": "bun run --bun oxfmt",
    "lint": "bun run --bun oxlint",
    "make": "bun build --compile ./app/index.server.ts --outfile ./build/kana-backend",
    "migrate": "bun run ./app/scripts/migrate.server.ts",
    "start": "NODE_ENV=production BUN_PORT=3001 ./build/kana-backend",
    "test": "bun run --bun vitest run",
    "typecheck": "bun run --bun tsc"
  },
  "dependencies": {
    "@kana/helpers": "workspace:*",
    "@rvf/react-router": "catalog:",
    "date-fns": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
